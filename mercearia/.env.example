# ── Copie este arquivo para .env e preencha os valores ──────────────────────
# O arquivo .env NÃO deve ser versionado (já está no .gitignore).

# Chave secreta do Django — gere uma nova com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=troque-por-uma-chave-gerada-acima

# Ativa o modo debug (True em desenvolvimento, False em produção)
DJANGO_DEBUG=True

# Hosts permitidos separados por vírgula (em produção: seudominio.com,www.seudominio.com)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
